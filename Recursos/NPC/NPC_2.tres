script = ExtResource("1_5d5lb")
nombre = "Antonio Rivero"
cantDialogos = 5
dialogos = ["Hermosa tardecita de faena, ¿no te parece?", "Tomate un descanso; pegate a la pulpería un rato.", "Yo me rajé de allá porque estaba más quieto que un pingo en invierno.", "Andá y cantáles una tuyita, que seguro les va a gustar.", "Nos vemos allá, Fierro."]
